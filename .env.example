# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env (2.5, 4.2).

# --- Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (2.5) ---
# sqlite en développement, mysql en recette/CI/production
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# Variables utilisées seulement si DB_ENGINE=mysql :
# DB_NAME=connecteplus
# DB_USER=connecteplus
# DB_PASSWORD=
# DB_HOST=db
# DB_PORT=3306

# --- Temps réel (Channels / Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- CORS (frontend React) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
